#include <windows.h>
1 ICON "synchromy.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "synchromy.manifest"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName", "Etienne Mineur, etienne.design"
      VALUE "FileDescription", "Synchromy"
      VALUE "FileVersion", "1.0"
      VALUE "ProductName", "Synchromy"
      VALUE "ProductVersion", "1.0"
      VALUE "LegalCopyright", "Etienne Mineur, 2026"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
